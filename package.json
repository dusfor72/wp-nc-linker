{
	"name": "wp-nc-linker",
	"version": "0.1.0-dev",
	"private": true,
	"description": "Use images and documents from Nextcloud folders and albums in the WordPress media library without copying them.",
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "wp-scripts build media-tab=./assets/src/media-tab/index.js --output-path=build",
		"start": "wp-scripts start media-tab=./assets/src/media-tab/index.js --output-path=build",
		"lint:js": "wp-scripts lint-js assets/src tests/e2e --no-error-on-unmatched-pattern",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.{css,scss}\" --allow-empty-input",
		"format": "wp-scripts format assets/src tests/e2e"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@wordpress/e2e-test-utils-playwright": "3.1.0",
		"@wordpress/scripts": "35.0.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "8.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/element": "10.0.0",
		"@wordpress/i18n": "7.0.0",
		"@wordpress/url": "5.0.0"
	}
}
