#. Plugin Name of the plugin
#: wp-nc-linker.php
msgid "WP Nextcloud Linker"
msgstr "WP Nextcloud Linker"

#. Description of the plugin
#: wp-nc-linker.php
msgid "Use images and documents from Nextcloud folders and albums in the media library without copying them to WordPress."
msgstr "Bilder und Dokumente aus Nextcloud-Ordnern und -Alben in der Mediathek nutzen, ohne sie nach WordPress zu kopieren."

