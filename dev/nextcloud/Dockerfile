FROM nextcloud:34.0.4-apache

# HTTPS with the development CA generated by dev/bin/setup.sh (mounted at /etc/wpncl-certs).
RUN a2enmod ssl \
	&& a2ensite default-ssl \
	&& sed -ri \
		-e 's#^(\s*SSLCertificateFile\s+).*#\1/etc/wpncl-certs/nextcloud.crt#' \
		-e 's#^(\s*SSLCertificateKeyFile\s+).*#\1/etc/wpncl-certs/nextcloud.key#' \
		/etc/apache2/sites-available/default-ssl.conf
